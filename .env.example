# ===========================================
# AI 點餐系統 — 環境變數範本
# 複製此檔案為 .env 並填入實際值
# ===========================================

# --- LLM 配置（語言模型）---
# LM Studio 或其他 OpenAI-compatible API 的端點
LLM_BASE_URL=http://127.0.0.1:1234/v1/chat/completions
LLM_MODEL=qwen2.5-14b-instruct-1m
LLM_TIMEOUT=120

# --- ASR 配置（語音識別）---
ASR_PROVIDER=whisper
ASR_MODEL_SIZE=base
ASR_LANGUAGE=zh

# --- TTS 配置（文字轉語音）---
TTS_PROVIDER=pyttsx3
TTS_LANGUAGE=zh
TTS_RATE=150
TTS_VOLUME=1.0

# --- API 配置 ---
# 未設定時停用 API Key 驗證（僅限開發環境）
# API_KEY=your-secret-key-here
API_PORT=8000

# --- 日誌配置 ---
LOG_LEVEL=INFO
LOG_FORMAT=color
# LOG_FORMAT=json  # 生產環境建議用 json
PERF_SLOW_THRESHOLD=5.0

# --- 測試模式 ---
USE_MOCK=false

# --- Benchmark 專用（可選）---
# ELEVENLABS_API_KEY=your-elevenlabs-key
