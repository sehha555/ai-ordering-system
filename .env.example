# ===========================================
# AI 點餐系統 — 環境變數範本
# 複製此檔案為 .env 並填入實際值
# ===========================================

# --- 環境分層 ---
ENVIRONMENT=dev                    # "dev" | "prod"
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDIS_URL=                         # 空=InMemory fallback, 填 redis://localhost:6379 啟用 Redis
SESSION_TTL_MINUTES=30

# --- LLM 配置（語言模型）---
# LM Studio OpenAI-compatible API 端點
LLM_BASE_URL=http://127.0.0.1:1234/v1/chat/completions
# 推薦：在 LM Studio 載入 qwen3-14b (Q4_K_M, ~9GB VRAM，適合 16GB 顯卡)
LLM_MODEL=qwen3-14b
LLM_TIMEOUT=120

# --- ASR 配置（語音識別）---
# 後端選擇：sensevoice（本地, 推薦）| qwen3asr（本地, 備用）
ASR_BACKEND=sensevoice
SENSEVOICE_MODEL=iic/SenseVoiceSmall
ASR_LANGUAGE=zh

# --- TTS 配置（文字轉語音）---
# 後端選擇：qwen3tts（本地, 推薦）| edgetts（雲端 Microsoft, 備用）
TTS_BACKEND=qwen3tts
QWEN3TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN3TTS_SPEAKER=Vivian  # 預設女聲，其他選項: Ryan, Cherry, Ethan...

# --- API 配置 ---
# 未設定時停用 API Key 驗證（僅限開發環境）
# API_KEY=your-secret-key-here
API_PORT=8000

# --- 日誌配置 ---
LOG_LEVEL=INFO
LOG_FORMAT=color
# LOG_FORMAT=json  # 生產環境建議用 json
LOG_RETENTION_DAYS=7               # 日誌保留天數（dev 7 天, prod 建議 30 天）
PERF_SLOW_THRESHOLD=5.0

# --- 測試模式 ---
USE_MOCK=false

# --- Benchmark 專用（可選）---
# ELEVENLABS_API_KEY=your-elevenlabs-key
