# ========== 環境分層 ==========
# "dev" 或 "prod"；prod 模式會強制要求 API_KEY 且建議 LOG_FORMAT=json
ENVIRONMENT=dev

# ========== CORS ==========
# 允許的前端來源，多個用逗號分隔
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ========== Session ==========
# 留空 = 使用 InMemory（重啟後清除）；填入 redis:// URL = Redis 持久化模式
REDIS_URL=
SESSION_TTL_MINUTES=30

# ========== ASR ==========
# ASR 後端選擇："sensevoice"（預設）| "qwen3asr"
ASR_BACKEND=sensevoice
# SenseVoice 模型 ID（ModelScope）
SENSEVOICE_MODEL=iic/SenseVoiceSmall
# 模型 Hub："ms" = ModelScope（必須，HuggingFace 版有亂碼問題）
SENSEVOICE_HUB=ms

# ========== TTS ==========
# TTS 後端選擇："edgetts"（預設，零 VRAM）| "qwen3tts"
TTS_BACKEND=edgetts

# ========== LLM 服務 ==========
# LLM OpenAI 相容端點（LM Studio 預設 port 1234）
LLM_BASE_URL=http://127.0.0.1:1234/v1/chat/completions
# 要使用的模型 ID（需與 LM Studio 載入的模型一致）
LLM_MODEL=qwen/qwen3-30b-a3b-2507
# 請求逾時秒數（複雜 tool call 建議至少 120）
LLM_TIMEOUT=120

# ========== 店家設定 ==========
STORE_NAME=源飯糰

# ========== 認證 ==========
# 警告：請勿將真實 API Key 提交至版本控制！
# 留空 = 不啟用認證（dev 環境可用）；prod 環境必須填入
API_KEY=

# ========== 日誌與效能 ==========
# 日誌等級："DEBUG" | "INFO"（預設）| "WARNING" | "ERROR"
LOG_LEVEL=INFO
# 日誌格式："color"（本地開發）| "json"（prod / log aggregator）
LOG_FORMAT=color
# 日誌保留天數（dev 建議 7，prod 建議 30）
LOG_RETENTION_DAYS=7
# 慢請求警告閾值（秒），超過此值會在日誌中標記 SLOW
PERF_SLOW_THRESHOLD=5.0

# ========== 上傳限制 ==========
# 音訊上傳最大位元組數（預設 10MB）
MAX_AUDIO_SIZE_BYTES=10485760

# ========== API 限流 ==========
# 格式："次數/時間單位"，例如 "10/minute"、"100/hour"
RATE_LIMIT_DIALOGUE=10/minute
RATE_LIMIT_CHECKOUT=5/minute
RATE_LIMIT_QUERY=60/minute
RATE_LIMIT_TEST=30/minute
